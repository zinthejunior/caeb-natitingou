# ─────────────────────────────────────────────────────────────────
# .env.example — Variables d'environnement du backend Django (CAEB)
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS commiter le fichier .env dans Git.
# ─────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────
SECRET_KEY='django-insecure-clé-généré'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# CONFIGURATION BASE DE DONNÉES POSTGRESQL (LOCAL)
# ============================================================

# Nom de la base PostgreSQL
# Par défaut : 'caeb_db'
DB_NAME=caeb_db

# Utilisateur PostgreSQL
# Par défaut : 'postgres'
DB_USER=postgres

# Mot de passe PostgreSQL
# ⚠️ Ne jamais partager ce mot de passe publiquement
DB_PASSWORD=postgres

# Adresse du serveur PostgreSQL
# Par défaut : 'localhost' (votre machine locale)
DB_HOST=localhost

# Port PostgreSQL
# Par défaut : 5432 (port standard PostgreSQL)
DB_PORT=5432


# ============================================================
# CONFIGURATION CORS & FRONTEND
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://caeb-natitingou.vercel.app
FRONTEND_URL=https://caeb-natitingou.vercel.app

# ============================================================
# CONFIGURATION EMAIL SMTP (ex: Gmail, Brevo, SendGrid)
# ============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-d-application
DEFAULT_FROM_EMAIL=CAEB Natitingou <no-reply@caeb-natitingou.org>
